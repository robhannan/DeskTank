{
  "name": "desktank-scripts",
  "private": true,
  "description": "Tooling scripts, web tests and the web page's TypeScript for DeskTank (zx, Playwright, tsc). The product is the Rust workspace.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:icons": "node scripts/build-icons.ts",
    "build:web": "node scripts/build-web.ts",
    "build:web:webos": "node scripts/build-web.ts --legacy",
    "check:webos": "node scripts/check-webos.ts",
    "serve:web": "node scripts/serve-web.ts",
    "test:web": "playwright test",
    "bench:web": "node scripts/bench-web.ts",
    "test:android": "tapsmith test",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json --noEmit && tsc -p web/worker/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "acorn": "8.19.0",
    "binaryen": "132.0.0",
    "esbuild": "0.28.2",
    "tapsmith": "0.8.0",
    "typescript": "7.0.2",
    "zx": "8.8.5"
  }
}
